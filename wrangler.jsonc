{
  // The Worker handles /api/* and serves everything else from ./public.
  //
  // run_worker_first matters: without it, Cloudflare's asset router answers
  // GET requests before the Worker sees them, so /api/approve, /api/review
  // and /api/selftest would all return the 404 page. POST still reached the
  // Worker, which is why the form errored while the links 404'd.
  //
  // Nothing to fill in here. The three secrets live in the dashboard under
  // Workers & Pages -> findwell -> Settings -> Variables and Secrets:
  //   RESEND_API_KEY, GH_TOKEN, SIGNING_SECRET
  "name": "findwell",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "SITE_URL": "https://findwelldirectory.com",
    "ADMIN_EMAIL": "info@findwelldirectory.com",
    // Must be on a domain verified in Resend. Sending as info@ rather than
    // noreply@ because the emails invite a reply.
    "MAIL_FROM": "FindWell Directory <info@findwelldirectory.com>",
    "GH_REPO": "wellivahealth/findwell",
    "GH_BRANCH": "main"
  }
}
