{
  // FULL CONFIG — copy this over wrangler.jsonc once the three secrets are set.
  // There are no database or namespace ids to fill in: the Worker stores
  // everything in this repo through the GitHub API.
  "name": "findwell",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  "vars": {
    "SITE_URL": "https://findwelldirectory.com",
    "ADMIN_EMAIL": "info@findwelldirectory.com",
    // Must be on a domain verified in Resend. Replies go to ADMIN_EMAIL.
    "MAIL_FROM": "FindWell Directory <noreply@findwelldirectory.com>",
    "GH_REPO": "wellivahealth/findwell",
    "GH_BRANCH": "main"
  }

  // Secrets, set once from the command line — never in this file:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put GH_TOKEN
  //   npx wrangler secret put SIGNING_SECRET
}
